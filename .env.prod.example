# Copie para .env.prod (fora do controle de versão) e preencha.
# Gere cada senha com:  openssl rand -hex 32   (somente hexadecimal: entra em URL).
# Use senhas DIFERENTES por ambiente e nunca reaproveite as de desenvolvimento.

# Domínio público servido pelo proxy (HTTPS automático via Let's Encrypt).
SITE_ADDRESS=app.exemplo.com
# Origem exata usada pelo navegador (esquema + domínio); deve ser https.
CORS_ORIGENS=https://app.exemplo.com
# Vazio em produção. Em ambiente local com certificado interno: local_certs
CADDY_OPCOES_GLOBAIS=

POSTGRES_DB=armadilhas
POSTGRES_SUPERUSER_SENHA=GERE_COM_OPENSSL
DB_MIGRADOR_SENHA=GERE_COM_OPENSSL
DB_APP_SENHA=GERE_COM_OPENSSL

MODEL_VERSION=v0.1.0-dev

# Opcionais (valores padrão entre parênteses).
# SESSAO_INATIVIDADE_SEGUNDOS=1800
# SESSAO_DURACAO_MAXIMA_SEGUNDOS=28800
# LOGIN_FALHAS_POR_CONTA=5
# LOGIN_FALHAS_POR_IP=30
# ANALISES_POR_MINUTO=30
# PROXY_HTTP_PORTA=80
# PROXY_HTTPS_PORTA=443
