# Substitua os placeholders antes de usar este arquivo como .env.

# Obrigatória.
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@db:5432/armadilhas

# Checkpoint PyTorch para `modelo`; em `onnx`, vazio usa o ONNX empacotado.
MODEL_WEIGHTS_PATH=/app/models/checkpoints/latest.pt

# Obrigatória.
MODEL_VERSION=v0.1.0-dev

# `stub`, `modelo` (PyTorch) ou `onnx` (modelo empacotado).
INFERENCE_MODE=stub

# Máximo de threads intraoperacionais do motor de inferência.
INFERENCE_THREADS=1

# Obrigatória.
UPLOADS_DIR=/app/data/uploads

# filesystem no Docker/local; database para armazenamento durável em serverless.
STORAGE_BACKEND=filesystem

# Catálogo licenciado externo usado apenas pelo seed; nunca dentro do checkout.
TRAPSIGHT_TRAINING_DATA_DIR=

# Obrigatória.
CORS_ORIGENS=http://localhost:5173

# Obrigatória: não. Padrão: 40.
LIMIAR_ATENCAO=10

# Obrigatória: não. Padrão: 70.
LIMIAR_TROCAR=20

# Obrigatória: não. Padrão: America/Sao_Paulo.
# Zona IANA cuja data civil define "hoje" na contagem de dias em uso do refil e
# na validação da data de instalação. Instantes continuam gravados em UTC.
FUSO_PRODUTO=America/Sao_Paulo
