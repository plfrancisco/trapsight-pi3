# Endereço da API para desenvolvimento local.
# Tudo em VITE_* vai para o bundle e é público; nunca coloque segredos aqui.

# Obrigatória. Em produção (mesma origem), use o caminho relativo /api.
VITE_API_URL=http://localhost:8000/api

# Exige login no frontend ("true" liga). O backend sempre exige sessão; esta chave só
# decide se a interface mostra a tela de login. Mantenha "true" (produção usa "true").
VITE_AUTENTICACAO_ATIVA=true
